# Copy to .env for local development (`npm run dev` loads it). Never commit .env.
# In production, set these as real environment variables instead of a file.

# development | test | production
NODE_ENV=development

# PostgreSQL of the self-hosted stack (NOT the Supabase database). Secret.
DATABASE_URL="postgres://autowascenter:change-me@localhost:5432/autowascenter"

# Listen address. Use 0.0.0.0 inside a container; 127.0.0.1 keeps it local.
HOST=127.0.0.1
PORT=3001

# Comma-separated browser origins allowed by CORS.
# Development default: http://localhost:8080 (Vite dev server). Required in production; "*" is rejected.
CORS_ORIGIN=http://localhost:8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# POST /api/bookings rate limit, per client IP (in-process memory; see README "Production notes").
BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW_MS=60000

# Auth0 (see docs/AUTH0-SETUP.md). Required in production. Not secrets: the API only
# verifies tokens with Auth0's public keys (JWKS) and needs no client secret.
# Tenant host only, no https:// and no path.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# The Auth0 API identifier; must equal the frontend's VITE_AUTH0_AUDIENCE.
AUTH0_AUDIENCE=https://api.your-domain.example
# Optional: only with an Auth0 custom domain. Default: https://<AUTH0_DOMAIN>/
# AUTH0_ISSUER=https://login.your-domain.example/
