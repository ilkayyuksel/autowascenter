# Web app (TanStack Start), LOCAL DEVELOPMENT ONLY. Copy to .env and fill in; never commit
# .env.
#
# This is not the production configuration. The production Docker stack has its own,
# complete environment file: deploy/.env.example -> deploy/.env (see deploy/README.md).
# Do not delete this file thinking it is that one.
#
# Every variable here starts with VITE_ and is embedded in the BROWSER bundle at build
# time: these values are public by design. Never put a secret here (no AUTH0_CLIENT_SECRET,
# no DATABASE_URL, no passwords). Server-only configuration of the API lives in
# apps/api/.env (see apps/api/.env.example and docs/SELF-HOSTED-ARCHITECTURE.md).

# --- Admin authentication: Auth0 (PUBLIC values, see docs/AUTH0-SETUP.md) ---
# Domain, SPA client id and API audience are not secrets. The SPA uses Authorization Code
# Flow + PKCE and has no client secret.
VITE_AUTH0_DOMAIN="your-tenant.eu.auth0.com"
VITE_AUTH0_CLIENT_ID="your-spa-client-id"
# Must equal AUTH0_AUDIENCE of the API (apps/api/.env).
VITE_AUTH0_AUDIENCE="https://api.your-domain.example"

# --- Self-hosted API (public URL, no trailing slash) ---
VITE_API_BASE_URL="http://localhost:3001"
