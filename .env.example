# Kopieer naar .env en vul de waarden in. Commit .env NOOIT.
#
# Huidige (Lovable/Supabase) configuratie. Deze variabelen verdwijnen in latere
# migratiefases en worden vervangen door de eigen API + Auth0 (zie docs/MIGRATION-STATUS.md).

# --- Frontend (build-time, in de browserbundel: publiek) ---
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Admin authentication: Auth0 (build-time, PUBLIC values, see docs/AUTH0-SETUP.md) ---
# Domain, SPA client id and API audience are not secrets. NEVER add AUTH0_CLIENT_SECRET here:
# the SPA uses Authorization Code Flow + PKCE and has no secret.
VITE_AUTH0_DOMAIN="your-tenant.eu.auth0.com"
VITE_AUTH0_CLIENT_ID="your-spa-client-id"
# Must equal AUTH0_AUDIENCE of the API (apps/api/.env).
VITE_AUTH0_AUDIENCE="https://api.your-domain.example"

# --- Self-hosted API (public URL) ---
VITE_API_BASE_URL="http://localhost:3001"

# --- Server / SSR ---
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_PROJECT_ID="your-project-ref"

# SECRET: omzeilt RLS. Alleen server-side, nooit met VITE_-prefix.
# Momenteel niet gebruikt door de code (src/integrations/supabase/client.server.ts).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
