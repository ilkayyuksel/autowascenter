# Server configuration of the Docker stack. Copy to deploy/.env and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# deploy/.env is NEVER committed (see .gitignore) and is never copied into an image
# (see .dockerignore). Only this example file, with placeholders, is in Git.
#
# Two kinds of values:
#   * VITE_*  are PUBLIC: they are compiled into the browser bundle at build time. Never
#             put a secret here. Changing one requires `docker compose build web`.
#   * all others are server-only and stay inside the containers.

# --- Domain ---------------------------------------------------------------------------
# The canonical public domain. Caddy requests the certificate for it and for www.<DOMAIN>.
# Use DOMAIN=localhost for a local test without DNS (Caddy then uses its internal CA).
DOMAIN=example.com

# --- PostgreSQL (server-only, SECRET) -------------------------------------------------
POSTGRES_DB=autowascenter
POSTGRES_USER=autowascenter
# Generate one, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-long-random-password

# Optional: overrides the connection string. Leave empty to let Compose derive it from the
# POSTGRES_* values above (host `postgres`, the internal service name).
DATABASE_URL=

# --- API ------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Behind Caddy the real client IP comes from X-Forwarded-For; without this the per-IP rate
# limits would count every visitor as one client. "true" trusts the proxy in front; a
# comma-separated list of IPs/subnets is stricter.
TRUST_PROXY=true

# Browser origins the API accepts. Defaults to https://<DOMAIN>. Browser requests are
# same-origin in this setup, so CORS is only needed for other clients. Never "*".
CORS_ORIGIN=

# Public base URL of the uploads, without trailing slash. Defaults to
# https://<DOMAIN>/uploads, which Caddy routes to the API.
PUBLIC_UPLOAD_URL=

# Max size of one uploaded gallery image, in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760

# Rate limits per client IP.
BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000

# --- Auth0, API side (public values; the API only verifies tokens) --------------------
# The API needs NO client secret. See docs/AUTH0-SETUP.md.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.example.com
# Only with an Auth0 custom domain; leave empty otherwise.
AUTH0_ISSUER=

# --- Web app (PUBLIC build-time values) ----------------------------------------------
# EMPTY on purpose: the browser then calls /api/... on the site's own origin, which Caddy
# forwards to the API. Do not set this to "/api": the API already serves its routes under
# /api, so that would produce /api/api/... . Only set a full origin (https://api.example.com)
# when the API is published on a separate host.
VITE_API_BASE_URL=
# Must match AUTH0_DOMAIN / AUTH0_AUDIENCE above.
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.example.com

# --- Backups --------------------------------------------------------------------------
# Dumps are written to the private backup volume; older ones are removed.
BACKUP_RETENTION_DAYS=14
# 86400 = once a day.
BACKUP_INTERVAL_SECONDS=86400
