# Server configuration of the production Docker stack.
#
#   cd deploy
#   cp .env.example .env && chmod 600 .env
#   # fill in every REQUIRED value below, then:
#   docker compose config          # must print the stack without errors
#
# WHERE THIS FILE IS READ FROM
# Compose reads `.env` from the directory of the compose file, so run `docker compose` from
# `deploy/`. If you run it from the repository root, pass both paths explicitly:
#
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml config
#
# Otherwise Compose reads the repository root's `.env` (which only holds the frontend's
# development values) and every variable below becomes a blank string.
#
# WHICH COMPOSE
# Docker Compose V2 is required: `docker compose` (the plugin), not the legacy standalone
# `docker-compose` (1.x). Check with `docker compose version`.
#
# TWO KINDS OF VALUES
#   * VITE_*  are PUBLIC and BUILD-TIME: they are compiled into the browser bundle, so
#             anyone can read them. Never put a secret here. Changing one has no effect
#             until you run `docker compose build web`.
#   * all others are SERVER-ONLY and RUNTIME: they stay inside the containers.
#
# deploy/.env is never committed (.gitignore) and never copied into an image
# (.dockerignore). Only this example file, with placeholders, is in Git.
#
# Legend:  [REQUIRED] no safe default; Compose refuses to start without it.
#          [OPTIONAL] has a documented default; leave empty to accept it.


# ======================================================================================
# Domain                                                     server-only, runtime
# ======================================================================================

# [REQUIRED] The canonical public domain, without scheme and without a trailing slash.
# Caddy requests the certificate for this host and for www.<DOMAIN>, and the API derives
# its CORS origin and its public uploads URL from it.
# Use DOMAIN=localhost for a local test without DNS; Caddy then uses its internal CA.
DOMAIN=example.com


# ======================================================================================
# PostgreSQL                                            server-only, runtime, SECRET
# ======================================================================================

# [REQUIRED] Database and role created on first start of an empty data volume. Changing
# them later does not rename anything in an existing volume.
POSTGRES_DB=autowascenter
POSTGRES_USER=autowascenter

# [REQUIRED] SECRET. Generate one, do not invent it by hand:
#   openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# [OPTIONAL] SECRET. Full connection string, overriding the four values above.
# Leave EMPTY: Compose then builds it as
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# The host is `postgres`, the Compose service name on the private network. Never use
# localhost or 127.0.0.1 here: inside the API container that is the API itself, not the
# database. Only set this to reach a database outside the stack.
DATABASE_URL=


# ======================================================================================
# API                                                        server-only, runtime
# ======================================================================================

# [OPTIONAL] fatal | error | warn | info | debug | trace | silent. Default: info.
LOG_LEVEL=info

# [OPTIONAL] Default: true. Behind Caddy the socket address is the proxy's, so the real
# client IP must come from X-Forwarded-For; without this the per-IP rate limits would count
# every visitor as one client. "true" trusts the proxy in front; a comma-separated list of
# IPs/subnets is stricter. Set to false only if the API is ever exposed directly.
TRUST_PROXY=true

# [OPTIONAL] Browser origins the API accepts, comma-separated. Default: https://<DOMAIN>.
# Requests from the site itself are same-origin, so this only matters for other clients.
# "*" is rejected in production.
CORS_ORIGIN=

# [OPTIONAL] Public base URL of the uploaded gallery files, no trailing slash.
# Default: https://<DOMAIN>/uploads, which Caddy routes to the API.
PUBLIC_UPLOAD_URL=

# [OPTIONAL] Max size of one uploaded gallery image, in bytes. Default: 10485760 (10 MiB).
# The API accepts 1024 .. 52428800.
MAX_UPLOAD_BYTES=10485760

# [OPTIONAL] Rate limits per client IP. Defaults: 10 bookings per 60000 ms, 30 uploads per
# 3600000 ms.
BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000

# Not configurable here: UPLOAD_DIR, HOST, PORT and NODE_ENV are fixed by the compose file
# and the images (the uploads volume is mounted at /app/uploads).


# ======================================================================================
# Auth0, API side                        server-only, runtime, NOT secret (public ids)
# ======================================================================================
# The API only VERIFIES tokens, so it needs no client secret at all, and none belongs in
# this file. See docs/AUTH0-SETUP.md.

# [REQUIRED] Tenant host name: no scheme, no path.
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# [REQUIRED] The API Identifier from Auth0. Must equal VITE_AUTH0_AUDIENCE below.
AUTH0_AUDIENCE=https://api.example.com

# [OPTIONAL] Default: https://<AUTH0_DOMAIN>/ . Only set this when the tenant uses an Auth0
# custom domain, and include the trailing slash.
AUTH0_ISSUER=


# ======================================================================================
# Web app                                              PUBLIC, BUILD-TIME (VITE_*)
# ======================================================================================
# These end up in the browser bundle. After changing one: docker compose build web

# [OPTIONAL] EMPTY ON PURPOSE, and that is the correct production setting. The browser then
# calls /api/... on the site's own origin and Caddy forwards it to the API container.
# Do NOT set this to "/api": the API already serves its routes under /api, so the result
# would be /api/api/... . Only set a full origin (https://api.example.com) if the API is
# ever published on a separate host.
VITE_API_BASE_URL=

# [REQUIRED] Must match AUTH0_DOMAIN and AUTH0_AUDIENCE above. The client id is the SPA
# Client ID from Auth0; it is public by design (the SPA uses PKCE, not a secret).
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.example.com


# ======================================================================================
# Backups                                                    server-only, runtime
# ======================================================================================
# Dumps go to the private backup volume, which only the backup service mounts.
# Restoring is documented in docs/BACKUP-RESTORE.md; a backup is not proven until a restore
# has been rehearsed on this server.

# [OPTIONAL] Default: 14. Dumps older than this many days are deleted.
BACKUP_RETENTION_DAYS=14

# [OPTIONAL] Default: 86400 (once a day), in seconds.
BACKUP_INTERVAL_SECONDS=86400
